{
  "name": "monk-outdoor-playtest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build:rules": "cd rules && gleam build --target javascript",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vite build && vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "test": "npm run build:rules && npm run test:unit && npm run test:worker",
    "typecheck": "npm run build:rules && wrangler types && svelte-check --tsconfig ./tsconfig.browser.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && tsc -p tsconfig.worker-test.json && tsc -p tsconfig.e2e.json",
    "build": "npm run build:rules && vite build",
    "check:bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": { "@tabler/icons": "3.48.0", "svelte": "5.57.1", "zod": "4.6.5" },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.0.0",
    "jsdom": "30.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
