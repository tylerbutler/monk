{
  "name": "monk-outdoor-playtest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build:rules": "cd rules && gleam build --target javascript",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vite build && vitest run --config vitest.worker.config.ts",
    "test": "npm run build:rules && npm run test:unit && npm run test:worker",
    "typecheck": "npm run build:rules && wrangler types && tsc -p tsconfig.browser.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && tsc -p tsconfig.worker-test.json",
    "build": "npm run build:rules && vite build",
    "check:bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": { "zod": "4.6.5" },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@types/node": "^24.0.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
